{
  "name": "@itrix/widget",
  "version": "0.1.0",
  "description": "Embeddable IT Helpdesk Ticket Widget for ITrix",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --format esm --dts",
    "build:standalone": "esbuild src/standalone-loader.tsx --bundle --minify --outfile=../../public/widget/v1/widget.js --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.41.0"
  }
}
